{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "types": ["node"],
        "paths": {
            "@common/*": ["./src/common/*"],
            "@Core/*": ["./src/main/Core/*"]
        }
    },
    "include": [
        "src/main/**/*",
        "src/preload/**/*",
        "src/common/**/*",
        "electron.vite.config.mts",
        "vitest.config.mts"
    ]
}
