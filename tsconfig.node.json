{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "outDir": ".types/node",
        "types": ["node"],
        "paths": {
            "@shared/*": ["./src/shared/*"],
            "@Core/*": ["./src/main/Core/*"]
        }
    },
    "include": ["src/main/**/*", "src/preload/**/*", "electron.vite.config.ts", "vitest.config.ts", "package.json"],
    "references": [{ "path": "./tsconfig.shared.json" }]
}
